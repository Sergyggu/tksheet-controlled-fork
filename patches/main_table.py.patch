+    def get_cell_font_style(self, datarn: int, datacn: int) -> str | None:
+        """cell -> row -> column, via the stock generic option resolver.
+
+        get_cell_kwargs returns {} when the key is absent, so the isinstance
+        check is what turns that into a real None.
+        """
+        style = self.get_cell_kwargs(datarn, datacn, key="font_style")
+        return style if isinstance(style, str) and style else None
+
+    def get_cell_font_family(self, datarn: int, datacn: int) -> str | None:
+        """Local family override using the stock cell -> row -> column resolver."""
+        family = self.get_cell_kwargs(datarn, datacn, key="font_family")
+        if not isinstance(family, str):
+            return None
+        family = family.strip()
+        return family or None
+
+    def font_fits_line_box(self, font: FontTuple) -> bool:
+        """Tier-1 runtime authority for one concrete requested FontTuple.
+
+        Safe means BOTH:
+        1) Tk resolves the requested family name to that same family (no silent
+           substitution), and
+        2) the current family/size/style pipe bbox fits inside the live global
+           table line box.
+
+        The verdict is cached per exact FontTuple and invalidated whenever the
+        global table font/zoom baseline changes.
+        """
+        try:
+            return self._font_ok_cache[font]
+        except KeyError:
+            pass
+        try:
+            resolved = str(self.tk.call("font", "actual", tuple(font), "-family")).strip()
+            same_family = resolved.casefold() == str(font[0]).strip().casefold()
+            ok = same_family and self.get_txt_dimensions("|", font)[1] <= self.table_txt_height
+        except (tk.TclError, TypeError, ValueError, IndexError):
+            ok = False
+        self._font_ok_cache[font] = ok
+        return ok
+
+    def get_cell_font(self, datarn: int, datacn: int) -> FontTuple:
+        """Effective font of one body cell.
+
+        Size is never stored locally: it always comes from the live global
+        table font, so zoom/theme rebuilds remain authoritative.  A family
+        override is accepted only through the Tier-1 runtime guard; otherwise
+        the family fails closed to the live base family while preserving style.
+
+        Style-only behavior remains the already-qualified v2 contract.
+        """
+        base = self.PAR.ops.table_font
+        style = self.get_cell_font_style(datarn, datacn)
+        family = self.get_cell_font_family(datarn, datacn)
+        if style is None and family is None:
+            return base
+        font = FontTuple(family or base[0], base[1], style or base[2])
+        if family is None or self.font_fits_line_box(font):
+            return font
+        return FontTuple(base[0], base[1], style or base[2])
+
+    def font_report(self, family: str, style: str | None = None) -> dict:
+        """Explain the current Tier-1 decision for developer tooling.
+
+        Status is one of: active, fallback, substituted, error.  `effective`
+        always describes the FontTuple the engine will actually hand to its
+        measure/wrap/draw path.
+        """
+        base = self.PAR.ops.table_font
+        family = str(family).strip()
+        want = FontTuple(family, base[1], style or base[2])
+        fallback = FontTuple(base[0], base[1], style or base[2])
+        report = {
+            "requested": tuple(want),
+            "base": tuple(base),
+            "line_box": self.table_txt_height,
+            "effective": tuple(fallback),
+        }
+        try:
+            resolved = str(self.tk.call("font", "actual", tuple(want), "-family")).strip()
+            pipe = self.get_txt_dimensions("|", want)[1]
+        except Exception as exc:
+            report.update(
+                status="error",
+                resolved_as=None,
+                substituted=False,
+                pipe_height=None,
+                overshoot=None,
+                reason=f"{type(exc).__name__}: {exc}",
+            )
+            return report
+
+        substituted = resolved.casefold() != family.casefold()
+        report.update(
+            resolved_as=resolved,
+            substituted=substituted,
+            pipe_height=pipe,
+            overshoot=pipe - self.table_txt_height,
+        )
+        if substituted:
+            report["status"] = "substituted"
+            report["reason"] = (
+                f"{family} resolved as {resolved}; Tier 1 fails closed to {base[0]}"
+            )
+        elif pipe > self.table_txt_height:
+            report["status"] = "fallback"
+            report["reason"] = (
+                f"{family} is {pipe - self.table_txt_height}px taller than the "
+                f"{self.table_txt_height}px line box at size {base[1]}"
+            )
+        else:
+            report["status"] = "active"
+            report["effective"] = tuple(want)
+            report["reason"] = f"{family} fits the {self.table_txt_height}px line box"
+        return report
+
+    def font_styles_present(self) -> bool:
+        """Original v2 semantic: are any local font_style options present?"""
+        return (
+            any("font_style" in v for v in self.col_options.values())
+            or any("font_style" in v for v in self.row_options.values())
+            or any("font_style" in v for v in self.cell_options.values())
+        )
+
+    def cell_fonts_present(self) -> bool:
+        """Fast-path gate for either local font_style or font_family options."""
+        if self.font_styles_present():
+            return True
+        return (
+            any("font_family" in v for v in self.col_options.values())
+            or any("font_family" in v for v in self.row_options.values())
+            or any("font_family" in v for v in self.cell_options.values())
+        )
+
+    # SUPER-GUI VENDOR EXTENSION: fixed-width segmented text -----------------
+    #
+    # A segmented cell is still one logical tksheet cell.  Only its one-line
+    # display text is painted as N independent Canvas text items at fixed slot
+    # centres.  Hit-testing in kit_grid calls segmented_text_index(), so draw
+    # and hit share this exact geometry and never reconstruct Unicode metrics.
+    @staticmethod
+    def segmented_text_geometry(
+        left: float,
+        right: float,
+        count: int,
+        slot_width: float,
+    ) -> tuple[float, float, tuple[float, ...]]:
+        count = int(count)
+        slot_width = float(slot_width)
+        if count <= 0 or slot_width <= 0:
+            return float(left), float(left), ()
+        run_width = count * slot_width
+        run_left = float(left) + ((float(right) - float(left)) - run_width) / 2.0
+        run_right = run_left + run_width
+        centres = tuple(run_left + (i + 0.5) * slot_width for i in range(count))
+        return run_left, run_right, centres
+
+    @classmethod
+    def segmented_text_index(
+        cls,
+        left: float,
+        right: float,
+        x: float,
+        count: int,
+        slot_width: float,
+    ) -> int | None:
+        run_left, run_right, _ = cls.segmented_text_geometry(left, right, count, slot_width)
+        if not (run_left <= float(x) < run_right):
+            return None
+        index = int((float(x) - run_left) // float(slot_width))
+        return index if 0 <= index < int(count) else None
+
