+    # SUPER-GUI VENDOR EXTENSION: per-cell font style ------------------------
+    #
+    # Style-only: options never store family or size, so zoom, theme rebuilds
+    # and set_table_font() keep working.  get_cell_font() is the SINGLE source
+    # of truth for the effective font of a body cell; every consumer (renderer,
+    # wrap, char metrics, autosize) must ask it and nothing else, so measure ==
+    # wrap == draw can never drift apart.
+    def font_char_widths(self, font: FontTuple) -> dict:
+        """char_widths sub-dict for font, created on first use.
+
+        redraw indexes self.char_widths[font] directly; without lazy creation
+        the first styled cell raises KeyError inside the redraw loop.
+        """
+        try:
+            return self.char_widths[font]
+        except KeyError:
+            d = self.char_widths[font] = {}
+            return d
